{
  "name": "@lab/registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./domain/*": "./src/domain/*.ts",
    "./ports/*": "./src/ports/*.ts",
    "./application/*": "./src/application/*.ts",
    "./testing": "./src/testing/index.ts",
    "./testing/*": "./src/testing/*.ts"
  },
  "dependencies": {
    "@lab/kernel": "workspace:*",
    "fp-ts": "2.16.11"
  },
  "scripts": {
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  }
}
