{
  "suitest": {
    "baseUrl": "https://the.suite.st/api/public/v4",
    //"baseUrl": "http://localhost:3002/v1/suitest",
    "tokenId": "oBAQ2OBK5q",
    "tokenPassword": "fe0e935bd26d941f531f3a3dc42147cc24f2ebac900160928b25f5298f60087b"
  },
  "slack": {
    "active": false,
    "botToken": "dev-slack-token"
  },
  "trpc": {
    "port": 3001,
    "hostname": "127.0.0.1"
  },
  "registry": {
    "dbPath": "data/device-registry.json"
  },
  "activationSchedule": {
    "days": ["monday", "tuesday", "wednesday", "thursday", "friday"],
    "from": "08:45",
    "to": "18:15"
  },
  "provisioning": {
    "apkPath": "../android/app/build/outputs/apk/release/app-release.apk",
    "packageId": "com.vflorio.supervisoragent",
    "activity": ".MainActivity",
    "versionCode": 1
  },
  "tracking": {
    "adb": {
      "policy": [["constantDelay", "10s"]]
    },
    "agent": {
      "policy": [["constantDelay", "15m"]]
    },
    "suitestCamera": {
      "policy": [["constantDelay", "30s"]]
    },
    "suitestControlUnit": {
      "policy": [["constantDelay", "120s"]]
    },
    "suitestDevice": {
      "policy": [["constantDelay", "60s"]]
    }
  },
  "log": {
    "level": "debug", // "error" | "warn" | "info" | "debug"
    "path": "data/logs.jsonl", // JSON Lines files
    "network": false // log HTTP responses (get/post, single or paginated)
  },
  "adb": {
    "port": 5555,
    // Timeout for device reconnection; individual retry form is fixed
    "waitForDeviceTimeout": "90s"
  },
  "workflows": [
    [
      // Auto-connects on app start; run manually in some cases
      "suitest-connect",
      [
        [
          "inputTap",
          {
            "x": 0.9,
            "y": 0.1
          }
        ], // connect button
        [
          "inputTap",
          {
            "x": 0.5,
            "y": 0.5
          }
        ] // confirm
      ]
    ],
    [
      "suitest-set-experimental-profile",
      [
        [
          "inputTap",
          {
            "x": 2200,
            "y": 160
          }
        ], // settings (top-right)
        ["sleep", "1s"],
        [
          "inputTap",
          {
            "x": 1000,
            "y": 400
          }
        ], // profile
        ["sleep", "1s"],
        [
          "inputTap",
          {
            "x": 1000,
            "y": 640
          }
        ], // profile: experimental
        ["sleep", "1s"],
        [
          "inputTap",
          {
            "x": 100,
            "y": 100
          }
        ] // back (top-left)
      ]
    ],
    [
      "suitest-camera-restart",
      [
        ["restartApp", "st.suite.camera"],
        ["await", ["probe", "activityResumed", "st.suite.android.suitestcamera.MainActivity"], "5s"],
        ["run", "suitest-set-experimental-profile"]
        // [
        //   "run",
        //   "suitest-connect"
        // ]
      ]
    ],
    [
      "suitest-camera-reboot",
      [
        ["reboot"],
        ["waitForDevice"],
        ["ensureActivity", "st.suite.camera", "st.suite.android.suitestcamera.MainActivity"],
        ["run", "suitest-set-experimental-profile"],
        ["run", "suitest-connect"]
      ]
    ],
    [
      "suitest-camera-restart-verified",
      [["run", "suitest-camera-restart"], ["await", ["truthy", "suitest_camera_connected"], "45s"]]
    ],
    [
      "suitest-camera-reboot-verified",
      [["run", "suitest-camera-reboot"], ["await", ["truthy", "suitest_camera_connected"], "60s"]]
    ],
    [
      "suitest-camera-update",
      [
        ["forceStopApp", "com.android.vending"],
        ["openUrl", "market://details?id=st.suite.camera"],
        ["sleep", "5s"], // attesa caricamento pagina
        [
          "inputTap",
          {
            "x": 1500,
            "y": 660
          }
        ] // tasto "Update"
      ]
    ]
  ],
  "recovery": [
    {
      "domain": "suitest-camera",
      "label": "Suitest Camera Connection",
      "tripwires": [
        {
          // Grace period before intervention; above one poll cycle
          "grace": "60s",
          "predicate": ["truthy", "suitest_camera_connected"],
          // Escalation sequenziale: prima prova con riavvio app, poi reboot del device
          "pipeline": [
            "or",
            ["workflow", "suitest-camera-restart-verified"],
            ["workflow", "suitest-camera-reboot-verified"]
          ],
          // Delay ritenta ogni 2m per altre 2 volte prima di notificare
          "retry": [["constantDelay", "2m"], ["limitRetries", 2]],
          "notify": [
            {
              "type": ["slack"],
              "channel": "#lab-supervisor",
              "message": "{{label}} ({{ip}}) suitest connection failed, manual intervention required",
              "policy": ["exhausted"]
            }
          ]
        }
      ]
    }
  ]
}
