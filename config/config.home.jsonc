{
  "suitest": {
    "baseUrl": "http://localhost:3002/v1/suitest",
    "tokenId": "dev-suitest-token-id",
    "tokenPassword": "dev-suitest-token-password"
  },
  "slack": {
    "active": false,
    "botToken": "dev-slack-token"
  },
  "trpc": {
    "port": 3001,
    "hostname": "127.0.0.1"
  },
  "log": {
    "level": "debug", // "error" | "warn" | "info" | "debug"
    "path": "data/logs.jsonl", // JSON Lines files
    "network": false // log HTTP responses (get/post, single or paginated)
  },
  "adb": {
    "port": 5555,
    // Max time to wait for device online after workflow-triggered reboot
    "waitForDeviceTimeout": "2m"
  },
  "provisioning": {
    "apkPath": "../android/app/build/outputs/apk/release/app-release.apk",
    "packageId": "com.vflorio.supervisoragent",
    "activity": ".MainActivity",
    "versionCode": 1
  },
  "tracking": {
    "adb": { "policy": [["constantDelay", "10s"]] },
    "agent": { "policy": [["constantDelay", "15m"]] },
    "suitestCamera": { "policy": [["constantDelay", "30s"]] },
    "suitestControlUnit": { "policy": [["constantDelay", "60s"]] },
    "suitestDevice": { "policy": [["constantDelay", "60s"]] }
  },

  // Applicative

  // Service activation schedule
  "activationSchedule": {
    "days": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
    "from": "00:00",
    "to": "23:59"
  },

  // Workflows lanciabili dalle pipelines
  "workflows": [
    [
      "open-chrome",
      [
        // Unlock swipe only if keyguard present; on unlocked screen would scroll foreground app
        ["when", ["probe", "keyguardShowing"], "unlock"],
        ["ensureActivity", "com.android.chrome", "com.google.android.apps.chrome.Main"],
        ["run", "open-developer-settings"]
      ]
    ],
    ["unlock", [["wakeUp"]]],
    [
      "open-chrome-reboot",
      [
        ["reboot"],
        ["waitForDevice"],
        ["sleep", "5s"],
        ["ensureActivity", "com.android.chrome", "com.google.android.apps.chrome.Main"]
      ]
    ],
    ["open-developer-settings", [["wakeUp"], ["openDeveloperSettings"]]],

    // "async" variants for recovery pipelines: same workflow + predicate confirmation
    ["open-chrome-async", [["run", "open-chrome"], ["await", ["truthy", "suitest_camera_connected"], "45s"]]],
    [
      "open-chrome-reboot-async",
      [["run", "open-chrome-reboot"], ["await", ["truthy", "suitest_camera_connected"], "60s"]]
    ]
  ],

  "recovery": [
    {
      "domain": "suitest-camera",
      "label": "camera-demo",
      "tripwires": [
        {
          // What to observe
          "predicate": ["truthy", "suitest_camera_connected"],
          // How long predicate must be false before pipeline triggers
          "grace": "10s",
          // Action on predicate false >= grace; sequential escalation
          "pipeline": ["or", ["workflow", "open-chrome-async"], ["workflow", "open-chrome-reboot-async"]],
          // If escalation fails; delay between retry cycles (confirmed predictions already in workflows)
          "retry": [["constantDelay", "2m"], ["limitRetries", 2]],
          "notify": [
            {
              "type": ["slack"],
              "channel": "#lab-supervisor",
              "message": "{{label}} ({{ip}}) suitest connection failed, manual intervention required",
              "policy": ["exhausted"]
            }
          ]
        }
      ]
    }
  ],
  "registry": {
    "dbPath": "data/device-registry.json",
    "devices": {
      // "cameras": [
      //   {
      //     "id": "tablet",
      //     "label": "Lenovo Tab M10",
      //     "controlled": true,
      //     "videoCaptureDeviceId": null,
      //     "adbId": "192.168.1.4:5555"
      //   }
      // ],
      // "adb": [{ "id": "192.168.1.4:5555", "label": "Lenovo Tab M10", "target": "192.168.1.4:5555" }]
    }
  }
}
