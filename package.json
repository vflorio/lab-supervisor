{
  "name": "supervisor",
  "version": "0.1.0",
  "author": {
    "name": "vflorio & ai"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.14",
    "@vitest/ui": "^4.0.16",
    "turbo": "^2.10.4",
    "vitest": "^4.0.16"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rm -rf dist && rm -rf packages/*/dist",
    "docs:check": "bun run docs/refresh.ts --check",
    "docs:refresh": "bun run docs/refresh.ts",
    "format": "turbo run format && bunx @biomejs/biome format --write",
    "lint": "turbo run lint && bunx @biomejs/biome check --write",
    "test:unit": "turbo run test"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
