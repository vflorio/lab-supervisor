{
  "suitest": {
    "baseUrl": "http://localhost:3002/v1/suitest",
    //"baseUrl": "https://the.suite.st/api/public/v4",
    "tokenId": "dev-suitest-token-id",
    "tokenPassword": "dev-suitest-token-password"
  },
  "slack": {
    "active": false,
    "botToken": "dev-slack-token"
  },
  "trpc": {
    "port": 3001,
    "hostname": "127.0.0.1"
  },
  "activationSchedule": {
    "days": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
    "from": "00:00",
    "to": "23:59"
  },
  "monitoring": {
    "polling": [["constantDelay", "30s"]] // loop principale
  },
  "tracking": {
    "adb": { "polling": [["constantDelay", "10s"]] }, // poll locale, nessun costo esterno
    "suitestCamera": { "polling": [["constantDelay", "30s"]] },
    "suitestControlUnit": { "polling": [["constantDelay", "60s"]] },
    "suitestDevice": { "polling": [["constantDelay", "60s"]] }
  },
  "log": {
    "level": "debug", // "error" | "warn" | "info" | "debug"
    //"file": "logs/service.log"
    "network": false // stampa le risposte HTTP (get/post, singole o paginate) indipendentemente da "level"
  },
  "adb": {
    "port": 5555,
    "reconnect": [
      ["constantDelay", "400ms"],
      ["exponentialBackoff", "800ms"],
      ["capDelay", "60s"],
      ["limitRetries", 10]
    ]
  },
  "workflows": [
    [
      "open-chrome",
      [
        // wake screen up
        ["wakeUp"],
        // Ensure App is running (start if not opened)
        ["ensureActivity", "com.android.chrome", "com.google.android.apps.chrome.Main"]
      ]
    ],
    [
      "open-chrome-reboot",
      [
        ["reboot"],
        // FIXME va rivista, attende sulla 5555, mentre dopo un reboot è necessario il processo di connessione
        ["waitForDevice"],
        ["ensureActivity", "com.android.chrome", "com.google.android.apps.chrome.Main"]
      ]
    ],
    ["open-developer-settings", [["wakeUp"], ["openDeveloperSettings"]]]
  ],
  // Demo locale del Recovery Model: nessun device reale dietro camera-tv-1 (vedi il suo
  // "adbId" più sotto, riusa apposta il target fittizio del "tablet"), quindi le pipeline
  // qui sotto falliranno sempre - il punto è osservare nei log il ciclo
  // trigger -> grace -> tentativo -> retry -> esaurimento, pilotabile flippando lo stato
  // del video-capture-device mock (PUT http://localhost:3002/_admin/video-capture-devices/vcd-001)
  "recovery": [
    {
      "label": "camera-recovery-demo",
      "domain": "suitest-camera",
      "levels": [
        {
          "grace": "10s",
          "predicate": ["ref", "suitest_camera_connected"],
          "pipeline": ["workflow", "open-chrome"],
          "retry": [["constantDelay", "2s"], ["limitRetries", 2]]
        },
        {
          "grace": "30s",
          "predicate": ["or", ["ref", "suitest_camera_recording"], ["ref", "suitest_camera_streaming"]],
          "pipeline": ["or", ["workflow", "open-chrome"], ["workflow", "open-chrome-reboot"]],
          "retry": [["constantDelay", "5s"], ["limitRetries", 2]]
        }
      ]
    }
  ],
  "registry": {
    "dbPath": "data/device-registry.json",
    "devices": {
      "cameras": [
        {
          "id": "tablet",
          "label": "Tablet",
          "controlled": true,
          "videoCaptureDeviceId": null,
          "adbId": "192.168.1.4:5555"
        },
        // Camere Suitest (video-capture-device) già collegate ai mock TV - riconciliate a mano per test
        {
          "id": "camera-tv-1",
          "label": "Camera_TV_1",
          "controlled": false,
          "videoCaptureDeviceId": "vcd-001",
          // Riusa il target fittizio del "tablet" solo per esercitare il recovery in locale
          // (nessun device reale dietro - vedi il blocco "recovery" più sopra)
          "adbId": "192.168.1.4:5555"
        },
        {
          "id": "camera-tv-2",
          "label": "Camera_TV_2",
          "controlled": false,
          "videoCaptureDeviceId": "vcd-002",
          "adbId": null
        },
        {
          "id": "camera-tv-3",
          "label": "Camera_TV_3",
          "controlled": false,
          "videoCaptureDeviceId": "vcd-003",
          "adbId": null
        },
        {
          "id": "camera-tv-4",
          "label": "Camera_TV_4",
          "controlled": false,
          "videoCaptureDeviceId": "vcd-004",
          "adbId": null
        }
      ],
      "tvs": [
        { "deviceId": "tv-001", "label": "TV_1", "controlled": false, "ip": "192.168.2.1" },
        { "deviceId": "tv-002", "label": "TV_2", "controlled": false, "ip": "192.168.2.2" },
        { "deviceId": "tv-003", "label": "TV_3", "controlled": false, "ip": "192.168.2.3" },
        { "deviceId": "tv-004", "label": "TV_4", "controlled": false, "ip": "192.168.2.4" }
      ],
      "adb": [{ "id": "192.168.1.4:5555", "label": "Tablet", "target": "192.168.1.4:5555" }]
    }
  }
}
