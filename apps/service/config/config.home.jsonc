{
  "suitest": {
    "baseUrl": "http://localhost:3002/v1/suitest",
    "tokenId": "dev-suitest-token-id",
    "tokenPassword": "dev-suitest-token-password"
  },
  "slack": {
    "active": false,
    "botToken": "dev-slack-token"
  },
  "trpc": {
    "port": 3001,
    "hostname": "127.0.0.1"
  },
  "log": {
    "level": "debug", // "error" | "warn" | "info" | "debug"
    "path": "data/logs.jsonl", // JSON Lines files
    "network": false // stampa le risposte HTTP (get/post, singole o paginate) indipendentemente da "tripwire"
  },
  "adb": {
    "port": 5555,
    // Se un workflow manda in reboot un device, questo timeout è il tempo massimo che aspettiamo il device per tornare online
    "waitForDeviceTimeout": "2m"
  },
  "tracking": {
    "adb": { "policy": [["constantDelay", "10s"]] },
    "suitestCamera": { "policy": [["constantDelay", "30s"]] },
    "suitestControlUnit": { "policy": [["constantDelay", "60s"]] },
    "suitestDevice": { "policy": [["constantDelay", "60s"]] }
  },

  // Applicative

  // Periodo di attivazione del servizio
  "activationSchedule": {
    "days": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
    "from": "00:00",
    "to": "23:59"
  },

  // Workflows lanciabili dalle pipelines
  "workflows": [
    [
      "open-chrome",
      [
        // TODO: Questa dovrebbe controllare perché altrimenti manda uno scroll
        ["wakeUp"],
        ["ensureActivity", "com.android.chrome", "com.google.android.apps.chrome.Main"],
        ["run", "open-developer-settings"]
      ]
    ],
    [
      "open-chrome-reboot",
      [
        ["reboot"],
        ["waitForDevice"],
        ["sleep", "5s"],
        ["ensureActivity", "com.android.chrome", "com.google.android.apps.chrome.Main"]
      ]
    ],
    ["open-developer-settings", [["wakeUp"], ["openDeveloperSettings"]]],

    // Varianti "verified" per le pipeline di recovery: stesso workflow + attesa della conferma
    // dai predicati. Senza, l'esito di un ramo direbbe solo "i comandi ADB non hanno fallito" e
    // l'`or` non escalerebbe mai (ensureActivity riesce anche con l'app che non si connette).
    // Il timeout deve superare tracking.suitestCamera (30s), altrimenti si giudica su dati stale.
    ["open-chrome-verified", [["run", "open-chrome"], ["awaitPredicate", ["ref", "suitest_camera_connected"], "45s"]]],
    [
      "open-chrome-reboot-verified",
      [["run", "open-chrome-reboot"], ["awaitPredicate", ["ref", "suitest_camera_connected"], "60s"]]
    ]
  ],

  "recovery": [
    {
      "domain": "suitest-camera",
      "label": "camera-recovery-demo",
      "tripwires": [
        {
          // Quanto tempo il predicate deve rimanere falso prima di scattare la pipeline
          "grace": "10s",
          // Cosa osservare
          "predicate": ["ref", "suitest_camera_connected"],
          // Cosa fare quando il predicate resta falso per >= grace. Escalation: prima il
          // rimedio leggero, poi il reboot - `or` prova il secondo ramo solo se il primo non ha
          // riportato il predicate a true (è il compito di `awaitPredicate` dentro i workflow
          // "verified": senza, un ramo "riesce" appena i comandi ADB non falliscono).
          "pipeline": ["or", ["workflow", "open-chrome-verified"], ["workflow", "open-chrome-reboot-verified"]],
          // Cosa fare se l'intera escalation non risolve. Ogni tentativo ora aspetta già la
          // conferma dai predicati al proprio interno (awaitPredicate) e il reboot attende il
          // device (adb.waitForDeviceTimeout): questo delay è solo respiro tra due escalation
          // complete, non serve più a coprire il tempo di propagazione dei fatti.
          "retry": [["constantDelay", "2m"], ["limitRetries", 2]],
          "notify": [
            {
              "type": ["slack"],
              "channel": "#lab-supervisor",
              "message": "{{label}} ({{ip}}) suitest connection failed, manual intervention required",
              "policy": ["exhausted"]
            }
          ]
        }
      ]
    }
  ],
  "registry": {
    "dbPath": "data/device-registry.json",
    "devices": {
      "cameras": [
        {
          "id": "tablet",
          "label": "Lenovo Tab M10",
          "controlled": true,
          "videoCaptureDeviceId": null,
          "adbId": "192.168.1.4:5555"
        }
      ],
      "tvs": [{ "deviceId": "tv-001", "label": "TV_1", "controlled": false, "ip": "192.168.2.1" }],
      "adb": [{ "id": "192.168.1.4:5555", "label": "Lenovo Tab M10", "target": "192.168.1.4:5555" }]
    }
  }
}
