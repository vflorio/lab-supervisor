{
  "suitest": {
    "baseUrl": "http://localhost:3002/v1/suitest",
    //"baseUrl": "https://the.suite.st/api/public/v4",
    "tokenId": "dev-suitest-token-id",
    "tokenPassword": "dev-suitest-token-password"
  },
  "slack": {
    "active": false,
    "botToken": "dev-slack-token"
  },
  "trpc": {
    "port": 3001,
    "hostname": "127.0.0.1"
  },
  "activationSchedule": {
    "days": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
    "from": "00:00",
    "to": "23:59"
  },
  "tracking": {
    "adb": { "polling": [["constantDelay", "10s"]] }, // poll locale, nessun costo esterno
    "suitestCamera": { "polling": [["constantDelay", "30s"]] },
    "suitestControlUnit": { "polling": [["constantDelay", "60s"]] },
    "suitestDevice": { "polling": [["constantDelay", "60s"]] }
  },
  "log": {
    "level": "debug", // "error" | "warn" | "info" | "debug"
    "path": "data/logs.jsonl", // JSON Lines files
    "network": false // stampa le risposte HTTP (get/post, singole o paginate) indipendentemente da "tripwire"
  },
  "adb": {
    "port": 5555,
    "reconnect": [
      ["constantDelay", "400ms"],
      ["exponentialBackoff", "800ms"],
      ["capDelay", "60s"],
      ["limitRetries", 10]
    ]
  },
  // Escalation sequenziale
  "workflows": [
    [
      "open-chrome",
      [
        // wake screen up
        ["wakeUp"],
        // Ensure App is running (start if not opened)
        ["ensureActivity", "com.android.chrome", "com.google.android.apps.chrome.Main"]
      ]
    ],
    [
      "open-chrome-reboot",
      [
        ["reboot"],
        // FIXME va rivista, attende sulla 5555, mentre dopo un reboot è necessario il processo di connessione
        ["waitForDevice"],
        ["ensureActivity", "com.android.chrome", "com.google.android.apps.chrome.Main"]
      ]
    ],
    ["open-developer-settings", [["wakeUp"], ["openDeveloperSettings"]]]
  ],
  "recovery": [
    {
      "domain": "suitest-camera",
      "label": "camera-recovery-demo",
      // Tripwire indipendente
      "tripwires": [
        {
          // Quanto tempo il predicate deve rimanere falso prima di scattare la pipeline
          "grace": "10s",
          // Cosa osservare
          "predicate": ["ref", "suitest_camera_connected"],
          // Cosa fare quando il predicate resta falso per >= grace
          "pipeline": ["workflow", "open-chrome"],
          // Cosa fare se la pipeline fallisce (es. crash, timeout, ecc.)
          "retry": [["constantDelay", "10s"], ["limitRetries", 2]]
        }
        //{
        //  "grace": "60s",
        //  "predicate": ["or", ["ref", "suitest_camera_recording"], ["ref", "suitest_camera_streaming"]],
        //  "pipeline": ["or", ["workflow", "open-chrome"], ["workflow", "open-chrome-reboot"]],
        //  "retry": [["constantDelay", "5s"], ["limitRetries", 2]]
        //}
      ]
    }
  ],
  "registry": {
    "dbPath": "data/device-registry.json",
    "devices": {
      "cameras": [
        {
          "id": "tablet",
          "label": "Lenovo Tab M10",
          "controlled": true,
          "videoCaptureDeviceId": null,
          "adbId": "192.168.1.4:5555"
        }
      ],
      "tvs": [{ "deviceId": "tv-001", "label": "TV_1", "controlled": false, "ip": "192.168.2.1" }],
      "adb": [{ "id": "192.168.1.4:5555", "label": "Lenovo Tab M10", "target": "192.168.1.4:5555" }]
    }
  }
}
