{
  "suitest": {
    "baseUrl": "https://the.suite.st/api/public/v4",
    "tokenId": "dev-suitest-token-id",
    "tokenPassword": "dev-suitest-token-password"
  },
  "slack": {
    "active": false,
    "botToken": "dev-slack-token"
  },
  "trpc": {
    "port": 3001,
    "hostname": "127.0.0.1"
  },
  "registry": {
    "dbPath": "data/device-registry.json"
  },
  "activationSchedule": {
    "days": ["monday", "tuesday", "wednesday", "thursday", "friday"],
    "from": "09:00",
    "to": "18:00"
  },
  "tracking": {
    "adb": { "policy": [["constantDelay", "5s"]] }, // local poll, no external cost
    "suitestCamera": { "policy": [["constantDelay", "20s"]] },
    "suitestControlUnit": { "policy": [["constantDelay", "20s"]] },
    "suitestDevice": { "policy": [["constantDelay", "20s"]] }
  },
  "log": {
    "level": "debug" // "error" | "warn" | "info" | "debug"
  },
  "adb": {
    "port": 5555,
    // Timeout for device reconnection; individual retry form is fixed
    "waitForDeviceTimeout": "90s"
  },
  "workflows": [
    [
      // Auto-connects on app start; run manually in some cases
      "suitest-connect",
      [
        ["inputTap", { "x": 0.9, "y": 0.1 }], // connect button
        ["inputTap", { "x": 0.5, "y": 0.5 }] // confirm
      ]
    ],
    [
      "suitest-set-experimental-profile",
      [
        ["inputTap", { "x": 2200, "y": 160 }], // settings (top-right)
        ["inputTap", { "x": 1000, "y": 440 }], // profile
        ["inputTap", { "x": 1000, "y": 640 }], // profile: experimental
        ["inputTap", { "x": 180, "y": 180 }] // back (top-left)
      ]
    ],
    [
      "android-suitest-test",
      [
        // wake screen
        ["wakeUp"],
        // Start app if not running
        ["ensureActivity", "st.suite.camera", "st.suite.android.suitestcamera.MainActivity"],
        ["run", "suitest-set-experimental-profile"]
      ]
    ],
    [
      "android-suitest-camera",
      [
        ["restartApp", "com.suitest.android.camera"],
        ["await", ["probe", "activityResumed", "com.suitest.android.camera.CameraActivity"], "30s"],
        // Connect taps use fixed coords; auto-reconnection would land on different UI
        ["when", ["not", ["ref", "suitest_camera_connected"]], "suitest-connect"]
      ]
    ],
    [
      "android-suitest-camera-reboot",
      [
        ["reboot"],
        ["waitForDevice"],
        ["ensureActivity", "com.suitest.android.camera", "com.suitest.android.camera.CameraActivity"],
        ["run", "suitest-set-experimental-profile"],
        ["run", "suitest-connect"]
      ]
    ],

    // "async" variants for recovery pipelines: workflow + predicate confirmation (without it, or-branches never escalate)
    [
      "android-suitest-camera-async",
      [["run", "android-suitest-camera"], ["await", ["ref", "suitest_camera_connected"], "45s"]]
    ],
    [
      "android-suitest-camera-reboot-async",
      [["run", "android-suitest-camera-reboot"], ["await", ["ref", "suitest_camera_connected"], "60s"]]
    ]
  ],

  "recovery": [
    {
      "domain": "suitest-camera",
      "label": "suitest-camera-recovery",
      "tripwires": [
        {
          // Grace period before intervention; above one poll cycle (20s)
          "grace": "60s",
          "predicate": ["ref", "suitest_camera_connected"],
          // Escalation: app restart, then device reboot (but never while recording); gate is here, not in workflow
          "pipeline": [
            "or",
            ["workflow", "android-suitest-camera-async"],
            [
              "and",
              ["condition", ["not", ["ref", "suitest_camera_recording"]]],
              ["workflow", "android-suitest-camera-reboot-async"]
            ]
          ],
          // Delay between escalation cycles (each awaits confirmation internally)
          "retry": [["constantDelay", "2m"], ["limitRetries", 2]],
          "notify": [
            {
              "type": ["slack"],
              "channel": "#lab-supervisor",
              "message": "{{label}} ({{ip}}) suitest camera offline, recovery esaurita: intervento manuale richiesto",
              "policy": ["exhausted"]
            }
          ]
        }
      ]
    }
  ]
}
