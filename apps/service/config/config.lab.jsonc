{
  "suitest": {
    "baseUrl": "https://the.suite.st/api/public/v4",
    "tokenId": "dev-suitest-token-id",
    "tokenPassword": "dev-suitest-token-password"
  },
  "slack": {
    "active": false,
    "botToken": "dev-slack-token"
  },
  "trpc": {
    "port": 3001,
    "hostname": "127.0.0.1"
  },
  "registry": {
    "dbPath": "data/device-registry.json"
  },
  "activationSchedule": {
    "days": ["monday", "tuesday", "wednesday", "thursday", "friday"],
    "from": "09:00",
    "to": "18:00"
  },
  "tracking": {
    "adb": { "policy": [["constantDelay", "5s"]] }, // poll locale, nessun costo esterno
    "suitestCamera": { "policy": [["constantDelay", "20s"]] },
    "suitestControlUnit": { "policy": [["constantDelay", "20s"]] },
    "suitestDevice": { "policy": [["constantDelay", "20s"]] }
  },
  "log": {
    "level": "debug" // "error" | "warn" | "info" | "debug"
  },
  "adb": {
    "port": 5555,
    // Pazienza di waitForDevice: quanto un workflow attende la riconnessione (già in corso in
    // background) prima di arrendersi. La forma dei singoli tentativi non è configurabile.
    "waitForDeviceTimeout": "90s"
  },
  "workflows": [
    [
      // Avviando l'applicazione la connessione è automatica, bisogna eseguire questo flow manualmente in alcuni casi
      "suitest-connect",
      [
        ["inputTap", { "x": 0.9, "y": 0.1 }], // tap connect button
        ["inputTap", { "x": 0.5, "y": 0.5 }] // tap confirm
      ]
    ],
    [
      "suitest-set-experimental-profile",
      [
        ["inputTap", { "x": 2200, "y": 160 }], // tap  right-top corner icon (settings)
        ["inputTap", { "x": 1000, "y": 440 }], // tap first setting (profile)
        ["inputTap", { "x": 1000, "y": 640 }], // tap third entry (profile: experimental)
        ["inputTap", { "x": 180, "y": 180 }] // tap left-top corner icon (back)
      ]
    ],
    [
      "android-suitest-test",
      [
        // wake screen up
        ["wakeUp"],
        // Ensure App is running (start if not opened)
        ["ensureActivity", "st.suite.camera", "st.suite.android.suitestcamera.MainActivity"],
        ["run", "suitest-set-experimental-profile"]
      ]
    ],
    [
      "android-suitest-camera",
      [
        ["restartApp", "com.suitest.android.camera"],
        ["waitForActivity", "com.suitest.android.camera.CameraActivity"],
        ["run", "suitest-connect"]
      ]
    ],
    [
      "android-suitest-camera-reboot",
      [
        ["reboot"],
        ["waitForDevice"],
        ["ensureActivity", "com.suitest.android.camera", "com.suitest.android.camera.CameraActivity"],
        ["run", "suitest-set-experimental-profile"],
        ["run", "suitest-connect"]
      ]
    ],

    // Varianti "verified" per le pipeline di recovery: stesso workflow + attesa della conferma
    // dai predicati. Un ramo di `or` che si limita a eseguire comandi "riesce" anche quando
    // l'app non si riconnette (restartApp/ensureActivity non falliscono), e l'escalation al
    // reboot non scatterebbe mai. Il timeout deve superare tracking.suitestCamera (20s).
    [
      "android-suitest-camera-verified",
      [["run", "android-suitest-camera"], ["awaitPredicate", ["ref", "suitest_camera_connected"], "45s"]]
    ],
    [
      "android-suitest-camera-reboot-verified",
      [["run", "android-suitest-camera-reboot"], ["awaitPredicate", ["ref", "suitest_camera_connected"], "60s"]]
    ]
  ],

  "recovery": [
    {
      "domain": "suitest-camera",
      "label": "suitest-camera-recovery",
      "tripwires": [
        {
          // Quanto la camera deve restare disconnessa prima di intervenire: sopra un giro di
          // polling (20s), così un singolo poll andato a vuoto non fa scattare nulla.
          "grace": "60s",
          "predicate": ["ref", "suitest_camera_connected"],
          // Escalation: riavvio dell'app, e solo se non basta reboot del device
          "pipeline": [
            "or",
            ["workflow", "android-suitest-camera-verified"],
            ["workflow", "android-suitest-camera-reboot-verified"]
          ],
          // Respiro tra due escalation complete: ogni tentativo attende già la conferma al
          // proprio interno (awaitPredicate) e il reboot attende il device (90s).
          "retry": [["constantDelay", "2m"], ["limitRetries", 2]],
          "notify": [
            {
              "type": ["slack"],
              "channel": "#lab-supervisor",
              "message": "{{label}} ({{ip}}) suitest camera offline, recovery esaurita: intervento manuale richiesto",
              "policy": ["exhausted"]
            }
          ]
        }
      ]
    }
  ]
}
