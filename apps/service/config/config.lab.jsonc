{
  "suitest": {
    //"baseUrl": "https://the.suite.st/api/public/v4",
    "baseUrl": "http://localhost:3002/v1/suitest",
    "tokenId": "dev-suitest-token-id",
    "tokenPassword": "dev-suitest-token-password"
  },
  "slack": {
    "active": false,
    "botToken": "dev-slack-token"
  },
  "trpc": {
    "port": 3001,
    "hostname": "127.0.0.1"
  },
  "registry": {
    "dbPath": "data/device-registry.json"
  },
  "activationSchedule": {
    "days": ["monday", "tuesday", "wednesday", "thursday", "friday"],
    "from": "09:00",
    "to": "23:00"
  },
  "tracking": {
    "adb": { "policy": [["constantDelay", "10s"]] },
    "suitestCamera": { "policy": [["constantDelay", "30s"]] },
    "suitestControlUnit": { "policy": [["constantDelay", "60s"]] },
    "suitestDevice": { "policy": [["constantDelay", "60s"]] }
  },
  "log": {
    "level": "debug" // "error" | "warn" | "info" | "debug"
  },
  "adb": {
    "port": 5555,
    // Timeout for device reconnection; individual retry form is fixed
    "waitForDeviceTimeout": "90s"
  },
  "workflows": [
    [
      // Auto-connects on app start; run manually in some cases
      "suitest-connect",
      [
        ["inputTap", { "x": 0.9, "y": 0.1 }], // connect button
        ["inputTap", { "x": 0.5, "y": 0.5 }] // confirm
      ]
    ],
    [
      "suitest-set-experimental-profile",
      [
        ["inputTap", { "x": 2200, "y": 160 }], // settings (top-right)
        ["inputTap", { "x": 1000, "y": 440 }], // profile
        ["inputTap", { "x": 1000, "y": 640 }], // profile: experimental
        ["inputTap", { "x": 180, "y": 180 }] // back (top-left)
      ]
    ],
    [
      "suitest-camera-restart",
      [
        ["restartApp", "com.suitest.android.camera"],
        ["await", ["probe", "activityResumed", "com.suitest.android.camera.CameraActivity"], "5s"],
        ["run", "suitest-set-experimental-profile"],
        ["run", "suitest-connect"]
      ]
    ],
    [
      "suitest-camera-reboot",
      [
        ["reboot"],
        ["waitForDevice"],
        ["ensureActivity", "com.suitest.android.camera", "com.suitest.android.camera.CameraActivity"],
        ["run", "suitest-set-experimental-profile"],
        ["run", "suitest-connect"]
      ]
    ],
    [
      "suitest-camera-restart-verified",
      [["run", "suitest-camera-restart"], ["await", ["truthy", "suitest_camera_connected"], "45s"]]
    ],
    [
      "suitest-camera-reboot-verified",
      [["run", "suitest-camera-reboot"], ["await", ["truthy", "suitest_camera_connected"], "60s"]]
    ]
  ],

  "recovery": [
    {
      "domain": "suitest-camera",
      "label": "Suitest Camera Connection",
      "tripwires": [
        {
          // Grace period before intervention; above one poll cycle
          "grace": "60s",
          "predicate": ["truthy", "suitest_camera_connected"],
          // Escalation sequenziale: prima prova con riavvio app, poi reboot del device
          "pipeline": [
            "or",
            ["workflow", "suitest-camera-restart-verified"],
            ["workflow", "suitest-camera-reboot-verified"]
          ],
          // Delay ritenta ogni 2m per altre 2 volte prima di notificare
          "retry": [["constantDelay", "2m"], ["limitRetries", 2]],
          "notify": [
            {
              "type": ["slack"],
              "channel": "#lab-supervisor",
              "message": "{{label}} ({{ip}}) suitest connection failed, manual intervention required",
              "policy": ["exhausted"]
            }
          ]
        }
      ]
    }
  ]
}
